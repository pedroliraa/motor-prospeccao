generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Empresa {
  id Int @id @default(autoincrement())

  cnpj         String  @unique
  razaoSocial  String?
  nomeFantasia String?

  cnae         String?
  cnaeDescricao String?

  logradouro   String?
  numero       String?
  bairro       String?
  cep          String?
  cidade       String?
  estado       String?

  telefone1    String?
  telefone2    String?
  email        String?

  // enriquecimento via CNPJ.ws (próxima etapa)
  capitalSocial    Float?
  regimeTributario String?
  porte            String?
  faturamentoEstimado String?  // faixa estimada ex: "até R$ 360k/ano"
  qtdeFuncionarios     String?  // faixa estimada ex: "1 a 19"
  dataAbertura     DateTime?
  socios           String?   // JSON serializado

  // presença digital (etapa 3)
  instagramHandle    String?
  instagramSeguidores Int?
  instagramStatus    String?
  googleNota         Float?
  googleAvaliacoes   Int?

  // scoring (etapa 4)
  score         Int?
  classificacao String?
  justificativa String?

  status String @default("pendente_enriquecimento")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Execucao {
  id            Int      @id @default(autoincrement())
  segmento      String
  status        String   @default("pendente")
  totalEmpresas Int      @default(0)
  createdAt     DateTime @default(now())
}

model Etiqueta {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  cor   String @default("#6B7280")
}